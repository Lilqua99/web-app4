{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app4",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5a89745a-24ab-48dc-b886-442e9a4a3f23","database_name": "web-app4" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a1ff52f100404281888393ad95a92ae9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
